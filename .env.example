# Copy to .env.local and fill in your own values (never commit .env.local).

# Neon Postgres connection string (Neon console -> Connect)
DATABASE_URL=

# Neon Auth (Neon console -> Auth)
NEON_AUTH_BASE_URL=
# Any random string with at least 32 characters, e.g. `openssl rand -base64 32`
NEON_AUTH_COOKIE_SECRET=
